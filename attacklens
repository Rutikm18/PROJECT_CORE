#!/usr/bin/env bash
# =============================================================================
#  attacklens — AttackLens management CLI
#
#  Usage:
#    ./attacklens doctor          # diagnose all dependencies and services
#    ./attacklens repair          # auto-fix deps (Buildx, Compose, BuildKit)
#    ./attacklens status          # show container status
#    ./attacklens logs [service]  # tail logs
#    ./attacklens restart         # restart all services
#    ./attacklens upgrade         # pull latest images and restart
# =============================================================================

set -euo pipefail

# ── Minimum required versions ────────────────────────────────────────────────
DOCKER_MIN="25.0.0"
COMPOSE_MIN="2.27.0"
BUILDX_MIN="0.17.0"
BUILDKIT_MIN="0.16.0"
BUILDER_NAME="attacklens-builder"

# ── Colours ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GRN='\033[0;32m'; YEL='\033[1;33m'; CYN='\033[0;36m'
BLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'

pass()  { echo -e "  ${GRN}✔${NC}  $*"; }
fail()  { echo -e "  ${RED}✘${NC}  $*"; }
warn()  { echo -e "  ${YEL}!${NC}  $*"; }
info()  { echo -e "  ${DIM}ℹ${NC}  $*"; }
hdr()   { echo ""; echo -e "${BLD}$*${NC}"; }

# ── Version helpers ────────────────────────────────────────────────────────────
extract_version() { echo "$1" | grep -oP '\d+\.\d+\.\d+' | head -1 || echo "0.0.0"; }

semver_gte() {
  local a="${1#v}" b="${2#v}"
  local a1 a2 a3 b1 b2 b3
  IFS='.' read -r a1 a2 a3 <<< "${a%-*}"
  IFS='.' read -r b1 b2 b3 <<< "${b%-*}"
  a1=${a1:-0}; a2=${a2:-0}; a3=${a3:-0}
  b1=${b1:-0}; b2=${b2:-0}; b3=${b3:-0}
  if   [ "$a1" -gt "$b1" ]; then return 0
  elif [ "$a1" -lt "$b1" ]; then return 1
  elif [ "$a2" -gt "$b2" ]; then return 0
  elif [ "$a2" -lt "$b2" ]; then return 1
  elif [ "$a3" -ge "$b3" ]; then return 0
  else return 1; fi
}

# ── Sudo ──────────────────────────────────────────────────────────────────────
if [ "$(id -u)" -eq 0 ]; then SUDO=""; else SUDO="sudo"; fi

# ── doctor ────────────────────────────────────────────────────────────────────
cmd_doctor() {
  local overall_ok=true

  echo ""
  echo -e "${BLD}${CYN}  AttackLens — System Doctor${NC}"
  echo -e "  ─────────────────────────────────────────"
  echo ""

  # OS
  hdr "  OS"
  local os_name="Unknown"
  if [ -f /etc/os-release ]; then
    . /etc/os-release 2>/dev/null || true
    os_name="${NAME:-Linux} ${VERSION_ID:-}"
  elif command -v sw_vers &>/dev/null; then
    os_name="macOS $(sw_vers -productVersion 2>/dev/null)"
  fi
  pass "$os_name ($(uname -m))"

  # Docker
  hdr "  Docker"
  if command -v docker &>/dev/null; then
    local docker_ver
    docker_ver=$(extract_version "$(docker --version 2>/dev/null)")
    if semver_gte "$docker_ver" "$DOCKER_MIN"; then
      pass "Docker ${docker_ver} ✔ (≥ ${DOCKER_MIN})"
    else
      fail "Docker ${docker_ver} — below minimum ${DOCKER_MIN}"
      overall_ok=false
    fi

    if docker info &>/dev/null 2>&1; then
      pass "Docker daemon running"
    else
      fail "Docker daemon not running"
      warn "Fix: sudo systemctl start docker"
      overall_ok=false
    fi
  else
    fail "Docker not installed"
    warn "Fix: curl -fsSL https://get.docker.com | bash"
    overall_ok=false
  fi

  # Docker Compose
  hdr "  Docker Compose"
  if docker compose version &>/dev/null 2>&1; then
    local compose_ver
    compose_ver=$(extract_version "$(docker compose version 2>/dev/null)")
    if semver_gte "$compose_ver" "$COMPOSE_MIN"; then
      pass "Docker Compose ${compose_ver} ✔ (≥ ${COMPOSE_MIN})"
    else
      fail "Docker Compose ${compose_ver} — below minimum ${COMPOSE_MIN}"
      warn "Fix: ./attacklens repair"
      overall_ok=false
    fi
  else
    fail "Docker Compose plugin not installed"
    warn "Fix: ./attacklens repair"
    overall_ok=false
  fi

  # Buildx
  hdr "  Docker Buildx"
  if docker buildx version &>/dev/null 2>&1; then
    local buildx_ver
    buildx_ver=$(extract_version "$(docker buildx version 2>/dev/null)")
    if semver_gte "$buildx_ver" "$BUILDX_MIN"; then
      pass "Buildx ${buildx_ver} ✔ (≥ ${BUILDX_MIN})"
    else
      fail "Buildx ${buildx_ver} — below minimum ${BUILDX_MIN}"
      warn "Fix: ./attacklens repair"
      overall_ok=false
    fi
  else
    fail "Buildx not installed"
    warn "Fix: ./attacklens repair"
    overall_ok=false
  fi

  # BuildKit builder
  hdr "  BuildKit Builder"
  local builder_ok=false
  if docker buildx inspect "$BUILDER_NAME" &>/dev/null 2>&1; then
    local bk_ver
    bk_ver=$(docker buildx inspect "$BUILDER_NAME" 2>/dev/null | \
      grep -i "buildkit" | grep -oP 'v?\d+\.\d+\.\d+' | head -1 || echo "?")
    pass "'${BUILDER_NAME}' builder — BuildKit ${bk_ver}"
    builder_ok=true
  else
    local default_bk_ver
    default_bk_ver=$(docker buildx inspect default 2>/dev/null | \
      grep -i "buildkit" | grep -oP '\d+\.\d+\.\d+' | head -1 || echo "0.0.0")
    if semver_gte "$default_bk_ver" "$BUILDKIT_MIN"; then
      pass "Default builder — BuildKit ${default_bk_ver} ✔"
      builder_ok=true
    else
      fail "Default builder — BuildKit ${default_bk_ver} < ${BUILDKIT_MIN}"
      warn "Fix: ./attacklens repair"
      overall_ok=false
    fi
  fi

  # Disk
  hdr "  Disk"
  local disk_avail
  disk_avail=$(df -m . 2>/dev/null | awk 'NR==2{print $4}' || echo "?")
  if [ "$disk_avail" != "?" ] && [ "$disk_avail" -ge 5120 ]; then
    pass "${disk_avail}MB free ✔ (≥ 5 GB required)"
  elif [ "$disk_avail" != "?" ]; then
    fail "${disk_avail}MB free — need at least 5 GB"
    warn "Fix: docker system prune -af"
    overall_ok=false
  fi

  # RAM
  hdr "  Memory"
  if [ -f /proc/meminfo ]; then
    local mem_mb
    mem_mb=$(awk '/MemTotal/{printf "%d",$2/1024}' /proc/meminfo)
    if [ "$mem_mb" -ge 2048 ]; then
      pass "${mem_mb}MB RAM ✔"
    else
      warn "${mem_mb}MB RAM — recommend ≥ 2 GB; installer will create swap"
    fi
  else
    info "Cannot read /proc/meminfo (macOS)"
  fi

  # Ports
  hdr "  Network Ports"
  for port in 80 443 8080 5672; do
    if command -v ss &>/dev/null && ss -tlnp 2>/dev/null | grep -q ":${port} "; then
      local proc
      proc=$(ss -tlnp 2>/dev/null | grep ":${port} " | head -1 | \
        sed 's/.*users:(("//' | cut -d'"' -f1 || echo "?")
      warn "Port ${port} — in use by ${proc}"
    else
      pass "Port ${port} — free"
    fi
  done

  # Python
  hdr "  Python"
  if command -v python3 &>/dev/null; then
    pass "python3 $(python3 --version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1)"
  else
    warn "python3 not installed (optional — needed for local scripts)"
  fi

  # Running services
  hdr "  AttackLens Services"
  if docker info &>/dev/null 2>&1 && \
     [ -f "$(dirname "$0")/docker-compose.yml" ]; then
    cd "$(dirname "$0")"
    for svc in postgres rabbitmq caddy manager threat-intel; do
      local st
      st=$(docker compose ps "$svc" --format '{{.Status}}' 2>/dev/null | head -1 || echo "not found")
      if echo "$st" | grep -qi "up\|healthy"; then
        pass "${svc}: ${st}"
      elif echo "$st" | grep -qi "not found\|^$"; then
        info "${svc}: not running"
      else
        fail "${svc}: ${st}"
        overall_ok=false
      fi
    done
  else
    info "Docker unavailable or not in repo dir — skipping service checks"
  fi

  # Internet
  hdr "  Internet Connectivity"
  if curl -fsSL --max-time 5 https://api.github.com &>/dev/null; then
    pass "github.com reachable"
  else
    fail "Cannot reach github.com"
    warn "Buildx/Compose downloads will fail without internet"
    overall_ok=false
  fi

  # Overall result
  echo ""
  echo "  ─────────────────────────────────────────"
  if [ "$overall_ok" = true ]; then
    echo -e "  ${GRN}${BLD}Overall: PASSED${NC}"
    echo ""
  else
    echo -e "  ${RED}${BLD}Overall: FAILED${NC}"
    echo ""
    echo -e "  Run ${BLD}./attacklens repair${NC} to auto-fix dependency issues."
    echo ""
    exit 1
  fi
}

# ── repair ────────────────────────────────────────────────────────────────────
cmd_repair() {
  echo ""
  echo -e "${BLD}${CYN}  AttackLens — Repair${NC}"
  echo -e "  ─────────────────────────────────────────"
  echo ""
  info "Detecting architecture..."

  local os arch
  os=$(uname -s | tr '[:upper:]' '[:lower:]')
  case "$(uname -m)" in
    x86_64|amd64)  arch="amd64" ;;
    aarch64|arm64) arch="arm64" ;;
    *) echo "Unsupported arch: $(uname -m)"; exit 1 ;;
  esac

  # ── Upgrade Buildx ─────────────────────────────────────────────────────────
  hdr "  Upgrading Buildx"
  local buildx_ver
  buildx_ver=$(curl -fsSL --max-time 10 \
    https://api.github.com/repos/docker/buildx/releases/latest 2>/dev/null | \
    grep '"tag_name"' | head -1 | sed 's/.*"v\([^"]*\)".*/\1/' || echo "0.21.1")
  local buildx_url="https://github.com/docker/buildx/releases/download/v${buildx_ver}/buildx-v${buildx_ver}.${os}-${arch}"
  info "Downloading Buildx v${buildx_ver}..."
  $SUDO mkdir -p /usr/local/lib/docker/cli-plugins
  if $SUDO curl -fsSL --max-time 120 "$buildx_url" \
       -o /usr/local/lib/docker/cli-plugins/docker-buildx 2>/dev/null; then
    $SUDO chmod +x /usr/local/lib/docker/cli-plugins/docker-buildx
    local installed_ver
    installed_ver=$(extract_version "$(docker buildx version 2>/dev/null || echo '0')")
    pass "Buildx ${installed_ver} installed"
  else
    fail "Buildx download failed — check internet connectivity"
  fi

  # ── Upgrade Compose ────────────────────────────────────────────────────────
  hdr "  Upgrading Docker Compose"
  local compose_ver os_cap
  os_cap=$(uname -s)
  compose_ver=$(curl -fsSL --max-time 10 \
    https://api.github.com/repos/docker/compose/releases/latest 2>/dev/null | \
    grep '"tag_name"' | head -1 | sed 's/.*"v\([^"]*\)".*/\1/' || echo "2.29.0")
  local compose_url="https://github.com/docker/compose/releases/download/v${compose_ver}/docker-compose-${os_cap}-$(uname -m)"
  info "Downloading Compose v${compose_ver}..."
  $SUDO mkdir -p /usr/local/lib/docker/cli-plugins
  if $SUDO curl -fsSL --max-time 120 "$compose_url" \
       -o /usr/local/lib/docker/cli-plugins/docker-compose 2>/dev/null; then
    $SUDO chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
    local installed_compose
    installed_compose=$(extract_version "$(docker compose version 2>/dev/null || echo '0')")
    pass "Docker Compose ${installed_compose} installed"
  else
    fail "Compose download failed"
  fi

  # ── Restart Docker daemon ──────────────────────────────────────────────────
  hdr "  Restarting Docker daemon"
  if command -v systemctl &>/dev/null && $SUDO systemctl is-active --quiet docker 2>/dev/null; then
    $SUDO systemctl restart docker 2>/dev/null && pass "Docker daemon restarted" || \
      warn "Could not restart daemon"
    sleep 3
  else
    info "Docker not running via systemctl — skipping daemon restart"
  fi

  # ── Create BuildKit builder ────────────────────────────────────────────────
  hdr "  Creating BuildKit builder"
  if docker buildx inspect "$BUILDER_NAME" &>/dev/null 2>&1; then
    pass "'${BUILDER_NAME}' builder already exists"
  else
    info "Creating builder..."
    if docker buildx create \
         --name "$BUILDER_NAME" \
         --driver docker-container \
         --use \
         --bootstrap 2>&1 | tail -2; then
      pass "Builder '${BUILDER_NAME}' created"
    else
      warn "Could not create builder — using default"
      docker buildx use default 2>/dev/null || true
    fi
  fi

  # ── Verify versions ────────────────────────────────────────────────────────
  hdr "  Verification"
  local bx_ver cv
  bx_ver=$(extract_version "$(docker buildx version 2>/dev/null || echo '0')")
  cv=$(extract_version "$(docker compose version 2>/dev/null || echo '0')")

  semver_gte "$bx_ver" "$BUILDX_MIN" && pass "Buildx ${bx_ver} ✔" || fail "Buildx ${bx_ver} still below ${BUILDX_MIN}"
  semver_gte "$cv"    "$COMPOSE_MIN" && pass "Compose ${cv} ✔"    || fail "Compose ${cv} still below ${COMPOSE_MIN}"

  echo ""
  echo -e "  ${GRN}${BLD}Repair complete.${NC} Re-run the installer:"
  echo "    bash install.sh"
  echo ""
}

# ── status ────────────────────────────────────────────────────────────────────
cmd_status() {
  [ -f "$(dirname "$0")/docker-compose.yml" ] || { echo "No docker-compose.yml found."; exit 1; }
  cd "$(dirname "$0")"
  echo ""
  docker compose ps
  echo ""
  echo -e "${DIM}Manager API:${NC}"
  curl -sf http://localhost:8080/health 2>/dev/null | python3 -m json.tool 2>/dev/null || \
    echo "  (not responding)"
  echo ""
}

# ── logs ──────────────────────────────────────────────────────────────────────
cmd_logs() {
  [ -f "$(dirname "$0")/docker-compose.yml" ] || { echo "No docker-compose.yml found."; exit 1; }
  cd "$(dirname "$0")"
  local svc="${1:-}"
  [ -n "$svc" ] && docker compose logs -f "$svc" || docker compose logs -f
}

# ── restart ───────────────────────────────────────────────────────────────────
cmd_restart() {
  [ -f "$(dirname "$0")/docker-compose.yml" ] || { echo "No docker-compose.yml found."; exit 1; }
  cd "$(dirname "$0")"
  local svc="${1:-}"
  if [ -n "$svc" ]; then
    docker compose restart "$svc"
    pass "Restarted ${svc}"
  else
    docker compose restart
    pass "All services restarted"
  fi
}

# ── upgrade ───────────────────────────────────────────────────────────────────
cmd_upgrade() {
  [ -f "$(dirname "$0")/docker-compose.yml" ] || { echo "No docker-compose.yml found."; exit 1; }
  cd "$(dirname "$0")"
  echo ""
  info "Pulling latest images..."
  docker compose pull 2>&1 | tail -10
  info "Restarting services..."
  docker compose up -d --remove-orphans
  pass "Upgrade complete"
  echo ""
}

# ── usage ─────────────────────────────────────────────────────────────────────
usage() {
  echo ""
  echo -e "${BLD}attacklens${NC} — AttackLens management CLI"
  echo ""
  echo -e "  ${BLD}./attacklens doctor${NC}            Diagnose all dependencies and services"
  echo -e "  ${BLD}./attacklens repair${NC}            Auto-fix Buildx, Compose, BuildKit builder"
  echo -e "  ${BLD}./attacklens status${NC}            Show container status + API health"
  echo -e "  ${BLD}./attacklens logs [service]${NC}    Tail logs (all or one service)"
  echo -e "  ${BLD}./attacklens restart [service]${NC} Restart services"
  echo -e "  ${BLD}./attacklens upgrade${NC}           Pull latest images and restart"
  echo ""
  echo -e "  Compatibility matrix enforced:"
  echo -e "    Docker  ≥ ${DOCKER_MIN}"
  echo -e "    Compose ≥ ${COMPOSE_MIN}"
  echo -e "    Buildx  ≥ ${BUILDX_MIN}"
  echo ""
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
CMD="${1:-help}"
shift || true

case "$CMD" in
  doctor)  cmd_doctor ;;
  repair)  cmd_repair ;;
  status)  cmd_status ;;
  logs)    cmd_logs "$@" ;;
  restart) cmd_restart "$@" ;;
  upgrade) cmd_upgrade ;;
  help|--help|-h) usage ;;
  *)
    echo "Unknown command: ${CMD}"
    usage
    exit 1
    ;;
esac
