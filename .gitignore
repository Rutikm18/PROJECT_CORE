# ═══════════════════════════════════════════════════════
#  .gitignore — AttackLens
# ═══════════════════════════════════════════════════════

# ── Runtime config (generated by env.sh / install.sh) ─
.env
.env.*
!.env.example
!env.sh
Caddyfile
agent.toml

# ── Runtime data & logs (generated at runtime) ────────
data/
logs/
certs/
output/
manager/data/
*.fifo
*.lock
.last_full_epoch
.watch_state/

# ── Python ────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Build artifacts ───────────────────────────────────
dist/
build/
*.spec.bak

# macOS agent packaging: the staging root under pkg_build is regenerated at
# build time (installer/build_pkg.sh rsyncs src into it), so it must never be
# tracked — it previously committed a recursive copy of the whole repo.
**/pkg_build/root/
*.pkg

# Node deps for the dashboard frontend source (Vite build inputs)
node_modules/

# ── Dev tool artifacts ────────────────────────────────
.commandcode/
.qodo/
graphify-out/
.claude/LEARNINGS.md
collector.log

# ── macOS ─────────────────────────────────────────────
.DS_Store
*.DS_Store

# ── AWS / security artifacts ──────────────────────────
*.pem
*.pkk
bandit-report.json
*-audit.json
sast-report.json

# ── Editor ────────────────────────────────────────────
*.swp
*.swo
.idea/
.vscode/
docker-compose.override.yml

LEARNINGS.md

# macOS agent pkg build: auto-incrementing version state (build-local)
agent/os/macos/pkg/.pkg_version

make_private_owner.md

core_level_detection_logic.md