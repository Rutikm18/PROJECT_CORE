# =============================================================================
#  .env.example — AttackLens / Jarvis Manager environment variables
#
#  Two ways to get a working .env:
#
#    A) Recommended — run the setup script:
#         bash env.sh
#       It detects your public IP, asks about domain vs IP-only TLS, generates
#       ADMIN_TOKEN / ENROLLMENT_TOKENS / JWT_SECRET, writes .env + Caddyfile,
#       and chmods .env to 0600. Re-running it PRESERVES every value you have
#       already set, including anything not listed in this file.
#
#    B) Manual — copy this file and fill it in:
#         cp .env.example .env && chmod 600 .env
#       At minimum set PUBLIC_IP, ADMIN_TOKEN, and JWT_SECRET.
#
#  Quoting: values containing spaces or shell metacharacters MUST be quoted
#  (see SMTP_FROM below). Avoid '$' in values — docker compose interpolates it.
#
#  NEVER commit .env to version control — it contains secrets.
# =============================================================================

# ── Network ───────────────────────────────────────────────────────────────────

# Server's public IP (auto-detected by env.sh)
PUBLIC_IP=

# Domain name (optional — only needed for Let's Encrypt TLS)
DOMAIN=

# Port Caddy listens on:
#   8443 → self-signed cert (IP-only mode, no domain)
#   443  → Let's Encrypt cert (domain mode)
BIND_PORT=8443

# Admin email for Let's Encrypt (only needed when DOMAIN is set)
ADMIN_EMAIL=

# ── TLS mode ──────────────────────────────────────────────────────────────────
# self-signed = Caddy internal CA  (IP-only, agents set tls_verify = false)
# letsencrypt = Let's Encrypt      (domain required, agents set tls_verify = true)
TLS_MODE=self-signed

# ── Auth ──────────────────────────────────────────────────────────────────────

# Admin token — protects the key management API (/api/v1/keys/*) and the AI
# provider API (/api/v1/ai/provider, /test, /task-models).
# Generated by env.sh. Format: sk-admin-<random>
ADMIN_TOKEN=

# Enrollment mode:
#   true  = any agent can connect (recommended for single operator)
#   false = agents must supply ENROLLMENT_TOKENS to register
OPEN_ENROLLMENT=true

# Enrollment token (only checked when OPEN_ENROLLMENT=false)
# Generated by env.sh. Format: sk-enroll-<random>
ENROLLMENT_TOKENS=

# REQUIRED IN PRODUCTION. Does double duty:
#   1. Signs dashboard session tokens (manager/manager/api/auth_ui.py)
#   2. Derives the AES-256 key encrypting your stored AI provider API key
#      (manager/manager/ai/key_store.py)
#
# Leave it empty and the manager degrades silently in two ways: every dashboard
# session is dropped on restart, and the AI key falls back to a random file
# written into the same directory as the ciphertext it protects.
#
# Changing it later logs everyone out AND makes the existing
# data/ai_provider.enc undecryptable (you re-enter the AI key in Settings).
# Generate with:  openssl rand -base64 32
JWT_SECRET=

# ── Dashboard login ───────────────────────────────────────────────────────────

# REQUIRED IN PRODUCTION. Leave DASHBOARD_PASSWORD_HASH empty and the manager
# falls back to a password hardcoded in manager/manager/api/auth_ui.py. That
# password is byte-identical on every AttackLens install, so an unset hash means
# anyone who has seen the source can log into this dashboard as admin.
#
# While the default is in use, GET /api/v1/auth/policy (unauthenticated, by
# necessity — the login screen needs the password rules) offers it as
# click-to-autofill. That is suppressed automatically once DOMAIN or PUBLIC_IP
# is set, but suppression only stops it being advertised: the default password
# still works until you replace it here.
#
# Generate the hash (never store the plaintext):
#   python3 -c "from manager.manager.security_policy import hash_password; \
#               import getpass; print(hash_password(getpass.getpass()))"
#
# Password rules the UI enforces: 16-128 chars, upper + lower + digit + symbol.
DASHBOARD_PASSWORD_HASH=pbkdf2:sha256:600000:123a47009bb36ffae0817308b8e9fc43c554a6142dfbc4a87bd11f872f9c9bb4:fd688192edc4337d4684e4071c35216a6e108c80443b3a71cc3bd44f63c36b56

# Login email for the account above. Defaults to admin@attacklens.ai.
DASHBOARD_EMAIL=admin@attacklens.ai

# ── Key Policy ────────────────────────────────────────────────────────────────

# Days until agent API keys expire. 0 = never expire.
DEFAULT_KEY_EXPIRY_DAYS=0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Empty = same-origin only, which is correct for the normal deployment: the
# dashboard is served by this manager through Caddy and needs no CORS grant.
# Set an explicit origin (https://dashboard.example.com) only if you serve the
# UI from a different host. Comma-separate multiple origins.
#
# Do NOT use '*'. With credentials allowed, the CORS layer echoes the caller's
# origin back whenever a cookie is present, so any website could call this API
# using a logged-in admin's session. If '*' is set anyway, the manager disables
# credentialed cross-origin requests and logs a warning.
CORS_ORIGINS=

# ── Container runtime user ────────────────────────────────────────────────────
# The manager/threat-intel images run as this uid/gid (manager/Dockerfile:
# useradd -u 1000 jarvis). install.sh chowns the ./data and ./logs bind mounts to
# it so the container can write its logs and store on first boot. Only change if
# you rebuild the image with a different user.
APP_UID=1000
APP_GID=1000

# =============================================================================
#  AI PROVIDER — this is the section to fill in for LLM features
# =============================================================================
#
# The API key is stored ENCRYPTED (AES-256-GCM) at data/ai_provider.enc, never
# in plaintext. There are two ways to get it there.
#
#  ── Option 1: bootstrap from this file (good for automated deploys) ──
#    Set the AI_* variables below. On startup, if no provider is configured
#    yet, the manager encrypts the key into data/ai_provider.enc. It is a
#    ONE-TIME seed: once configured, changes here are ignored — the stored
#    config always wins, so a stale key here can never override one rotated
#    through the API. Clear the values from .env afterwards if you prefer them
#    not to sit on disk.
#    No network call is made at startup; verify the key with:
#      curl -X POST https://<manager>/api/v1/ai/test -H "X-Admin-Token: $ADMIN_TOKEN"
#
#  ── Option 2: configure at runtime (recommended) ──
#    Dashboard → Settings → AI Provider, or:
#      curl -X POST https://<manager>/api/v1/ai/provider \
#           -H "X-Admin-Token: $ADMIN_TOKEN" \
#           -H 'Content-Type: application/json' \
#           -d '{"provider":"openrouter","api_key":"sk-or-...",
#                "model":"openai/gpt-oss-20b:free"}'
#    The key is health-checked against the live provider before it is saved.
#    No restart needed, and it can be rotated without touching .env.

# anthropic | openai | gemini | ollama | openrouter
# openrouter is recommended: one key reaches every model (including Claude),
# and it is the only provider with spend guards, cost tracking, and native
# structured output wired up.
AI_PROVIDER=openrouter

# Model ID for the chosen provider. For openrouter, ':free' means no cost
# (rate-limited). Per-task overrides live in Settings → AI Provider.
AI_MODEL=openai/gpt-oss-20b:free

# Your API key. OpenRouter keys start with 'sk-or-'.
AI_API_KEY=

# Custom endpoint — only for ollama, Azure OpenAI, or a proxy. Leave empty
# otherwise.
AI_BASE_URL=

# ── OpenRouter transport ──────────────────────────────────────────────────────
# Attribution headers — these identify your deployment in the OpenRouter
# dashboard. Cosmetic only.
OPENROUTER_APP_URL=https://attacklens.ai
OPENROUTER_APP_TITLE=AttackLens

# ── Usage guard ───────────────────────────────────────────────────────────────
# The kill switch halts all OpenRouter calls immediately without a redeploy.
# The three caps below are independent, because no single one covers free models.
#
# IMPORTANT for free-tier deployments: free models report $0, so the COST cap
# never fires on them. The two CALL caps are the only thing bounding a runaway
# loop on a free model.
ATTACKLENS_OPENROUTER_ENABLED=true

# OpenRouter allows 20 requests/minute on ':free' model variants. This ceiling
# does NOT rise with account credit — setting this higher only converts a local
# refusal into an upstream 429.
ATTACKLENS_OPENROUTER_MAX_CALLS_PER_MINUTE=20

# Free accounts get 50 requests/day. A one-time $10 credit purchase raises this
# permanently to 1000/day (it is a lifetime unlock, not a balance requirement).
# Set to 50 if you have not purchased credit.
ATTACKLENS_OPENROUTER_MAX_CALLS_PER_DAY=1000

# Daily spend cap in USD, process-local. Only meaningful for paid models.
ATTACKLENS_OPENROUTER_DAILY_BUDGET_USD=0.5

# ── Verdict cache ─────────────────────────────────────────────────────────────
# The detection loop re-evaluates every open finding on each 60s cycle. Answered
# prompts are cached so an unchanged finding costs one call, not one per cycle.
# A change to the evidence, the model, the prompt or the schema all produce a
# new key, so this TTL only bounds how stale an *unchanged* verdict may get.
ATTACKLENS_AI_VERDICT_CACHE_TTL_S=604800

# ── Model tier and free-model privacy ────────────────────────────────────────
# ATTACKLENS_AI_MODEL_TIER controls which OpenRouter model tier is used:
#
#   free (default) — use the :free model configured above; training-on-input
#       is accepted implicitly. Zero cost, but your endpoint telemetry
#       (process names, packages, finding evidence) may be used for training.
#
#   paid — require a paid model; the ALLOW_TRAINING gate below still applies
#       if you ever manually configure a :free model.
#
#   auto — try the free model first; fall back to ATTACKLENS_AI_FALLBACK_MODEL
#       on any failure. Best balance: no cost for normal runs, paid quality
#       when the free tier is overloaded or down.
#
# If ATTACKLENS_AI_MODEL_TIER=paid and you have privacy concerns, also set
# ATTACKLENS_AI_ALLOW_TRAINING_MODELS=false (the default) so any accidental
# :free model selection is refused rather than silently accepted.
ATTACKLENS_AI_MODEL_TIER=free

# Paid fallback model used when tier=auto and the free model fails.
# Any OpenRouter model ID works here; gpt-4o-mini is cheap and fast.
ATTACKLENS_AI_FALLBACK_MODEL=openai/gpt-4o-mini

# Legacy explicit opt-in (superseded by tier=free/auto above).
# Set true only when tier=paid but you explicitly want a :free model.
ATTACKLENS_AI_ALLOW_TRAINING_MODELS=false

# ── Legacy Anthropic-only path ────────────────────────────────────────────────
# Used by the remediation API (manager/manager/ai_analyst.py). Prefer the
# AI_PROVIDER block above; this remains for backward compatibility and falls
# back to the encrypted store when left empty.
ANTHROPIC_API_KEY=
AI_ANALYST_MODEL=claude-sonnet-4-6
AI_ANALYST_ENABLED=true

# ── Post-finding LangGraph investigation ─────────────────────────────────────
# Runs only after deterministic detection has persisted a finding. The graph is
# read-only until an analyst approves its verdict; remediation remains a draft.
LANGGRAPH_INVESTIGATIONS_ENABLED=true
LANGGRAPH_AUTO_INVESTIGATE=true
LANGGRAPH_AUTO_SEVERITIES=critical,high
LANGGRAPH_MAX_REVIEW_ROUNDS=2

# ── AttackLens precision validation ───────────────────────────────────────────
# Master switch for the cluster→signal validation pipeline. When false, findings
# emit the legacy way (every rule hit → finding).
ATTACKLENS_VALIDATION=false

# When true, every cluster that passes the 8 deterministic gates is *also* scored
# by the AI precision validator (LLM verdict + multi-source TI + cross-layer +
# baseline drift + asset tier + FP history). Only promotes findings whose
# composite precision score >= ATTACKLENS_AI_PRECISION_THRESHOLD.
ATTACKLENS_AI_VALIDATION=false

# Minimum precision score to promote a cluster to a finding (0.0-1.0).
ATTACKLENS_AI_PRECISION_THRESHOLD=0.90

# ── Threat Intel API Keys (all optional — feeds degrade gracefully) ───────────
# AbuseIPDB — IP reputation scoring (https://www.abuseipdb.com/api)
ABUSEIPDB_KEY=

# OTX AlienVault — IP/domain threat intel (https://otx.alienvault.com)
OTX_KEY=

# GreyNoise Community — scanner/noise detection (https://www.greynoise.io)
GREYNOISE_KEY=

# ── Email Notifications ───────────────────────────────────────────────────────
# SMTP (generic — works with Office 365, Gmail, Exchange, Postfix, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Quoted — the value contains spaces and angle brackets.
SMTP_FROM="AttackLens Alerts <alerts@yourorg.com>"
# "starttls" (port 587), "ssl" (port 465), or "none"
SMTP_TLS=starttls

# Microsoft Graph API (Office 365 OAuth — alternative to SMTP)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_SENDER=

# Comma-separated recipient lists
ALERT_RECIPIENTS=
DIGEST_RECIPIENTS=

# Set "false" to disable all email notifications
EMAIL_ENABLED=true

# ── Threat Feed Intervals ─────────────────────────────────────────────────────
THREAT_FEED_INTERVAL_SECONDS=3600
NVD_SYNC_INTERVAL_SECONDS=7200
NVD_SYNC_HOURS=48
NVD_SYNC_MAX_PAGES=3
NVD_MIRROR_ENABLED=true
# Strongly recommended for the initial full NVD mirror and timely delta syncs.
NVD_API_KEY=
