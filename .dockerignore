# Git
.git
.gitignore

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
dist/
build/
.eggs/

# Tests / dev tools
*/tests/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Runtime data (mounted as volumes)
# NOTE: dockerignore patterns are context-root-relative — "data/" alone does
# NOT match manager/data/, which held 447MB of live telemetry (manager.db +
# hot/warm/cold tiers) and was silently baked into every image build.
data/
certs/
logs/
manager/data/
manager/logs/

# Agent tree — no manager/threat-intel Dockerfile copies it, but without this
# the whole ~450MB (PyInstaller dists, PKGs, logs, spool) is still sent to the
# docker daemon as build context on every build.
agent/

# Secrets
.env
.secrets
*.key
*.pem
*.p12

# Agent binary build artifacts
agent/build/
agent/dist/
*.spec

# Dashboard node_modules — dashboard is mounted as a volume at runtime,
# node_modules must never be copied into the image (adds 500MB+ of
# platform-specific binaries that break Linux builds from macOS dev machines)
**/node_modules
manager/dashboard/**/node_modules
manager/dashboard/templates/**/node_modules

# Windows artifacts
agent/os/windows/pkg/*.msi
agent/os/windows/pkg/*.wixobj
